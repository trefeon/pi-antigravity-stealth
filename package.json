{
  "name": "pi-antigravity-stealth",
  "version": "1.2.6",
  "type": "module",
  "main": "index.ts",
  "description": "Stealth Google Antigravity plugin for OMP & Pi: Hub wire spoofing, Argon quota isolation, auto-patching, and saved credential recovery",
  "license": "MIT",
  "author": "trefeon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trefeon/pi-antigravity-stealth.git"
  },
  "homepage": "https://github.com/trefeon/pi-antigravity-stealth#readme",
  "bugs": {
    "url": "https://github.com/trefeon/pi-antigravity-stealth/issues"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "omp-plugin",
    "antigravity",
    "google-antigravity",
    "stealth",
    "anti-ban",
    "gemini",
    "claude",
    "cloud-code-assist"
  ],
  "files": [
    "index.ts",
    "src",
    "skills"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "omp": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "bun test ./tests/plugin.test.ts",
    "typecheck": "tsc --noEmit",
    "patch": "bun run scripts/patch-omp.ts",
    "link": "omp plugin link .",
    "check:drift": "bun run scripts/check-upstream-drift.ts",
    "sync:upstream": "bun run scripts/check-upstream-drift.ts --apply",
    "publish:webauth": "node scripts/publish-npm-webauth.mjs"
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "^18.20.0",
    "@oh-my-pi/pi-coding-agent": "^18.20.0",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
